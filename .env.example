# Frontend (Vite) — safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel serverless functions under /api — server-only, never prefixed
# with VITE_. Set these in Vercel → Project → Settings → Environment
# Variables, not in a committed .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_resend_key

# Optional fallback if a project's Settings → SignWell API key field is
# left blank (the DB value takes priority — see api/send-contract.js).
SIGNWELL_API_KEY=
SIGNWELL_TEST_MODE=false

# Supabase Edge Function (supabase/functions/signwell-webhook) — set via
# `supabase secrets set`, not here.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# PORTAL_URL=https://your-portal.vercel.app
# SIGNWELL_WEBHOOK_SECRET=a-random-string-you-append-to-the-webhook-url
